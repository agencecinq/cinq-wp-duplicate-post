{
	"name": "agencecinq/cinq-wp-duplicate-post",
	"description": "Adds a Duplicate link to the admin list screens that copies a post into a new draft.",
	"type": "wordpress-plugin",
	"license": "MIT",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
