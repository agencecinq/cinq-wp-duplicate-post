<?xml version="1.0"?>
<ruleset name="CINQ Duplicate Post">
	<description>WordPress Coding Standards for cinq-wp-duplicate-post.</description>

	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<!-- Generated by WordPress from the .mo file. -->
	<exclude-pattern>*/languages/*.l10n.php</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_supported_wp_version" value="6.0"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="cinq"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cinq-wp-duplicate-post"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>cinq-wp-duplicate-post\.php$</exclude-pattern>
	</rule>
</ruleset>
